{
	"name": "vite-plugin-doctest",
	"version": "3.0.0",
	"description": "Vite plugin for documentation testing powered with vitest",
	"type": "module",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"keywords": [
		"vite",
		"plugin",
		"doctest",
		"documentation",
		"test",
		"testing",
		"vitest"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ssssota/doc-vitest.git"
	},
	"author": "TOMIKAWA Sotaro <tommysouta@gmail.com>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/ssssota/doc-vitest/issues"
	},
	"homepage": "https://github.com/ssssota/doc-vitest#readme",
	"peerDependencies": {
		"@ox-jsdoc/wasm": "0.0.19",
		"vite": ">=8.0.0",
		"vitest": ">=4.1.0"
	},
	"peerDependenciesMeta": {
		"@ox-jsdoc/wasm": {
			"optional": true
		}
	},
	"devDependencies": {
		"@ox-jsdoc/wasm": "0.0.19",
		"@types/node": "^26.6.5",
		"magic-string": "^1.4.3",
		"remark-parse": "^11.0.0",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"unified": "^11.0.5",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@ox-jsdoc/decoder": "0.0.19",
		"ox-jsdoc": "0.0.19",
		"oxc-parser": "0.156.0"
	}
}
